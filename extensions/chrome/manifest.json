{
  "manifest_version": 3,
  "name": "Odoo MCP Browser",
  "description": "Connect logged-in website tabs to your own MCP server.",
  "version": "1.2.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "tabs", "tabGroups", "activeTab", "alarms", "notifications"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Odoo MCP Browser"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src https: wss:"}
}
