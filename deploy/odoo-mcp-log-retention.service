[Unit]
Description=Enforce two-day hosted journal and MCP file-log retention
[Service]
Type=oneshot
ExecStart=/usr/bin/journalctl --rotate --vacuum-time=2days
ExecStart=/usr/sbin/logrotate --state /var/lib/logrotate/odoo-mcp.status /etc/logrotate.d/odoo-mcp
ExecStart=/usr/bin/find /var/tmp -maxdepth 1 -type f ( -name mcp-*.log -o -name mcp-*-result.json ) -mmin +2880 -delete
