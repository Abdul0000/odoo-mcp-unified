[Unit]
Description=Fixed Odoo MCP update/restart controller
After=network-online.target

[Service]
Type=oneshot
User=root
Group=odoo-mcp
EnvironmentFile=-/etc/odoo-mcp/odoo-mcp.env
ExecStart=/usr/bin/python3 /opt/odoo-mcp/deploy/server_control.py
TimeoutStartSec=900
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/odoo-mcp/control
