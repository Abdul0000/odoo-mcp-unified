[Unit]
Description=Odoo MCP GitHub Deployment Webhook Receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=odoo-mcp
Group=odoo-mcp
WorkingDirectory=/opt/odoo-mcp/deploy
EnvironmentFile=/etc/odoo-mcp/webhook.env
ExecStart=/usr/bin/python3 /opt/odoo-mcp/deploy/webhook_receiver.py
Restart=always
RestartSec=2
# sudo must be able to use its setuid transition for the single allowlisted
# systemctl start odoo-mcp-deploy@*.service command. The receiver validates
# the instance suffix as a 40-character hexadecimal commit before invoking it.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/odoo-mcp /opt/odoo-mcp

[Install]
WantedBy=multi-user.target
