[Unit]
Description=Odoo MCP GitHub Deployment Webhook Receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=odoo-mcp
Group=odoo-mcp
WorkingDirectory=/opt/odoo-mcp/current
EnvironmentFile=/etc/odoo-mcp/webhook.env
ExecStart=/usr/bin/python3 /opt/odoo-mcp/current/deploy/webhook_receiver.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/odoo-mcp /opt/odoo-mcp

[Install]
WantedBy=multi-user.target
