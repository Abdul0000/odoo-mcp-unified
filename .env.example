# Copy to .env for local development. Never commit the real .env file.
# Keep production secrets in the Oracle VM environment file, not in GitHub.

ODOO_AGENT_API_TOKEN=replace-with-a-long-random-secret
ODOO_AGENT_PUBLIC_BASE_URL=https://your-public-https-domain
ODOO_AGENT_ALLOWED_ROOTS=/var/lib/odoo-mcp/repos,/tmp
ODOO_AGENT_STATE_DIR=/var/lib/odoo-mcp/state
ODOO_AGENT_PATTERN_CACHE_DIR=/var/lib/odoo-mcp/cache

# GitHub/GitLab credentials are optional until private repository access is needed.
GITHUB_TOKEN=
# Per-client GitLab/GitHub access tokens belong in each client's token field.
# Never put a real token in this example file.

# JSON array. Keep [] until you have entered fresh credentials for each client.
# Client fields: name, repo, branch, path, token, environment,
# odoo_url, odoo_db, odoo_login, odoo_password, odoo_api_key,
# odoo_verify_ssl, odoosh_db_name, odoosh_ssh_host, odoosh_ssh_port,
# odoosh_ssh_user, odoosh_ssh_key_path, odoosh_ssh_private_key_b64,
# odoosh_odoo_path, odoosh_user_addons_path.
ODOO_CLIENTS=[]

# Production-safe defaults. Do not disable approval for a public connector.
ODOO_AGENT_REQUIRE_APPROVAL=true
ODOO_AGENT_OPERATION_GUARD_ENABLED=true
ODOO_AGENT_FUNCTIONAL_OPERATIONS_ENABLED=false
ODOO_HTTPS_VERIFY_SSL=true
ODOO_AGENT_QUERY_TOKEN_AUTH_ENABLED=false
ODOO_AGENT_OAUTH_AUTO_APPROVE=false
ODOO_AGENT_OAUTH_AUTO_APPROVE_LOOPBACK=true
ODOO_AGENT_OAUTH_ALLOW_LOOPBACK_REDIRECTS=true

# Workspace and Git settings
WORKSPACE_ROOT=/var/lib/odoo-mcp/repos
GIT_AUTHOR_NAME=Odoo MCP Agent
GIT_AUTHOR_EMAIL=odoo-mcp@example.local
ODOO_AGENT_PROTECTED_BRANCHES=main,master,production,prod,live
ODOO_AGENT_WS_PROTECTED_BRANCHES=main,master,production,prod,live

# Optional Odoo.sh SSH defaults (per-client values take precedence)
ODOOSH_SSH_PORT=22
ODOOSH_SSH_USER=odoo
ODOOSH_ODOO_PATH=/home/odoo/src/odoo
ODOOSH_USER_ADDONS_PATH=/home/odoo/src/user
ODOOSH_WAIT_TIMEOUT_SECONDS=600
ODOOSH_WAIT_INTERVAL_SECONDS=10

CORE_SYNC_ENABLED=true
CORE_SYNC_MAX_AGE_SECONDS=3600
ODOO_AGENT_VERIFY_IMPACT_AWARE_DEFAULT=true
